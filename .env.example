# ==========================================
# HealthIntel Environment Variables
# ==========================================
# Copy this file to .env and fill in values

# Django
SECRET_KEY=your-very-secret-django-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
DATABASE_URL=postgresql://healthintel:healthintel_pass@postgres:5432/healthintel_db
POSTGRES_DB=healthintel_db
POSTGRES_USER=healthintel
POSTGRES_PASSWORD=healthintel_pass

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Provider — set to "gemini" or "openai"
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (alternative)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini model
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Calendar medication reminders
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback/
FRONTEND_URL=http://localhost:5173

# Classifier
ENABLE_TRANSFORMER_CLASSIFIER=false

# FAISS index storage path (relative to backend/)
FAISS_INDEX_PATH=ml/models_store/faiss_index

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Google Calendar OAuth (create a Web application credential in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback/
